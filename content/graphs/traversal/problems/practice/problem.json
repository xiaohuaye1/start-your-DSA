{
  "id": "graphs.traversal.practice.workshop_v2",
  "title": "图遍历实战：DFS、BFS 与连通分量",
  "time_limit_ms": 2000,
  "cases": [
    {
      "name": "DFS、BFS 的访问顺序不同",
      "input": "5 5 1\n1 2\n1 3\n2 4\n3 4\n4 5\n",
      "expected": "1 2 4 3 5\n1 2 3 4 5\n1\n0 1 1 2 3\n",
      "sample": true
    },
    {
      "name": "从指定起点出发再补遍历其他分量",
      "input": "6 4 4\n1 2\n2 3\n4 5\n5 6\n",
      "expected": "4 5 6 1 2 3\n4 5 6 1 2 3\n2\n-1 -1 -1 0 1 2\n",
      "sample": false
    },
    {
      "name": "带环和孤立顶点",
      "input": "5 3 2\n1 2\n2 3\n3 1\n",
      "expected": "2 1 3 4 5\n2 1 3 4 5\n3\n1 0 1 -1 -1\n",
      "sample": false
    }
  ]
}
