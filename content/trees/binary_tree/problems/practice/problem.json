{
  "id": "trees.binary_tree.practice.workshop_v2",
  "title": "二叉树实战：建树、四种遍历与层序深度",
  "time_limit_ms": 2000,
  "cases": [
    {
      "name": "前序建树、四种遍历和层数",
      "input": "ABD##E##C#F##\n",
      "expected": "ABDECF\nDBEACF\nDEBFCA\nABCDEF\n3 3 6\n",
      "sample": true
    },
    {
      "name": "只有右孩子的普通链状树",
      "input": "A#B#C##\n",
      "expected": "ABC\nABC\nCBA\nABC\n3 1 3\n",
      "sample": false
    },
    {
      "name": "空树无需访问空指针",
      "input": "#\n",
      "expected": "EMPTY\nEMPTY\nEMPTY\nEMPTY\n0 0 0\n",
      "sample": false
    }
  ]
}
