      "expected": "2\nOK\n8 3 1 3\nINVALID\nINVALID\n4\n",
      "sample": false
    },
    {
      "name": "头节点自环与重建连接",
      "input": "1 8\n7\n2 1\n3 3\n4\n5\n1 1 0\n3 4\n4\n5\n",
      "expected": "7\nEMPTY\n0\nOK\n0\n1\n",
      "sample": false
    }
  ]
