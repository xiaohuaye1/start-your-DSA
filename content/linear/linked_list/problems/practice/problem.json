      "expected": "OK\nOK\nOK\n4\n1 2 9 6 8\n6\n9\n8 6 9 2 1\n5\n",
      "sample": true
    },
    {
      "name": "偶数长度的中点和重复值",
      "input": "4 7\n3 1 3 2\n8\n3 3\n7 4\n2 5\n1 5 0\n7 1\n5\n",
      "expected": "3\n1\n3\nINVALID\nOK\n0\n3 1 3 2 0\n",
      "sample": false
    },
    {
      "name": "空链表也能反转和释放",
      "input": "1 10\n0\n2 1\n4\n5\n8\n7 1\n9 7\n10 9\n1 0 5\n5\n7 2\n",
      "expected": "0\nEMPTY\nEMPTY\nINVALID\nOK\nOK\nINVALID\n7 9\n7\n",
      "sample": false
    }
